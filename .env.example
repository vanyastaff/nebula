# Nebula — example environment file
#
# Copy this to `.env` (which is git-ignored) and fill in real values for
# local development. Any `.env.*` variant is also git-ignored except this
# `.env.example` template. Do not put secrets here.
#
# Variables below are grouped by the crate that reads them. All env reads go
# through the `nebula-env` typed reader (`crates/env/`, ADR-0086); the per-crate
# knob sets live in `apps/server/src/compose.rs`, `crates/api/src/config/`
# (the `API_*` registry in `crates/api/src/config/env.rs`),
# `crates/log/src/config/`, `crates/storage/`, `apps/server/src/transport.rs`.
# Only variables that the codebase actually consumes are listed.

# ============================================================================
# Environment metadata (apps/server, crates/api, crates/log)
# ============================================================================

# dev | staging | production. Read by compose, api/config, log, sentry.
NEBULA_ENV=dev

# Service identity used in structured logs / traces / sentry releases.
NEBULA_SERVICE=nebula
NEBULA_INSTANCE=local-dev
NEBULA_REGION=local
NEBULA_VERSION=0.0.0-dev

# ============================================================================
# Storage (crates/storage, apps/server/compose.rs)
# ============================================================================

# PostgreSQL connection string used by storage adapter and integration tests.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://nebula:nebula@localhost:5432/nebula

# Ordinary server: durable SQLite and an in-process worker by default.
# API_EXECUTION_BACKEND=sqlite          # sqlite | postgres; memory is test-only
# API_EXECUTION_DB_PATH=nebula-server-execution.db
# API_EXECUTION_MAX_CONNECTIONS=8       # PostgreSQL pool size, 1..=1000
# NEBULA_EXECUTION=in-process           # separate-workers requires PostgreSQL

# How long a finished (completed, failed, cancelled, timed out) execution is
# kept before the server deletes it with its journal, node results and queued
# commands. A whole number with s, m, h or d (e.g. 30d), 1h to 36500d. Unset or
# 0 keeps executions forever (the default). Live executions are never deleted.
# API_EXECUTION_RETENTION=30d

# Standalone worker (`nebula-worker`, apps/worker/src/main.rs lists every variable).
# NEBULA_WORKER_DB_MAX_CONNECTIONS=8           # PostgreSQL pool size, 1..=1000
# Control queue: claimed work polls again after the poll interval; each empty
# claim doubles the delay up to the idle ceiling (default: 10 poll intervals).
# On PostgreSQL an enqueue also wakes the worker at once (LISTEN/NOTIFY).
# NEBULA_WORKER_CONTROL_POLL_INTERVAL_MS=100   # 1..=60000
# NEBULA_WORKER_CONTROL_IDLE_POLL_MAX_MS=1000  # poll interval..=300000
# NEBULA_WORKER_CONTROL_BATCH_SIZE=32          # commands per claim and dispatch slots, 1..=1000

# ============================================================================
# HTTP / API (crates/api/src/config/mod.rs)
# ============================================================================

# API_BIND_ADDRESS=0.0.0.0:8080
# API_PUBLIC_URL=http://localhost:8080
# WEBHOOK_BASE_URL=http://localhost:8080

# Webhook transport (apps/server/src/transport.rs, apps/server/src/compose.rs).
# WEBHOOK_BIND_ADDRESS overrides the listener bind for webhooks;
# WEBHOOK_BOOTSTRAP_FROM_STORAGE toggles bootstrap-on-startup (default true).
# WEBHOOK_BIND_ADDRESS=0.0.0.0:8081
# WEBHOOK_BOOTSTRAP_FROM_STORAGE=true

# Comma-separated origins, or `*` for permissive dev.
# API_CORS_ORIGINS=http://localhost:5173

# Body limit in bytes (default in code).
# API_MAX_BODY_SIZE=1048576

# Deadline in seconds for producing a response; a slower request gets 503.
# Must be positive.
# API_REQUEST_TIMEOUT=30

# Requests the server runs at once; further requests get 503 with
# Retry-After. /health and /ready are exempt. Must be positive.
# API_MAX_CONCURRENT_REQUESTS=1024

# Rate limit — plain integer, requests per second (parsed as u64 in
# `crates/api/src/config/mod.rs`). Default 100.
# API_RATE_LIMIT=100

# Peers whose X-Forwarded-For / X-Real-IP the rate limiter believes:
# comma-separated addresses or CIDR blocks of your reverse proxies. Empty
# (the default) limits every client by its TCP peer address, so put the
# proxy here when one terminates client connections.
# API_TRUSTED_PROXIES=10.0.0.0/8,::1

# Header name carrying the request id (default in code).
# API_REQUEST_ID_HEADER=x-request-id

# Idempotency backend: only `memory` or `postgres` are accepted (case
# insensitive). Anything else — e.g. `redis` — fails at boot with
# ApiConfigError::ParseEnum (see crates/api/src/config/sub.rs tests).
# API_IDEMPOTENCY_BACKEND=memory

# Idempotency tuning (used by both memory and postgres backends).
# API_IDEMPOTENCY_TTL_SECS=3600
# API_IDEMPOTENCY_MAX_ENTRIES=10000
# API_IDEMPOTENCY_MAX_REQUEST_BODY_BYTES=1048576
# API_IDEMPOTENCY_MAX_RESPONSE_BODY_BYTES=1048576
# API_IDEMPOTENCY_SWEEP_INTERVAL_SECS=120

# Tracing / compression toggles.
# API_ENABLE_TRACING=true
# API_ENABLE_COMPRESSION=true

# ----------------------------------------------------------------------------
# Email delivery (SMTP) — apps/server/src/email/smtp.rs
# ----------------------------------------------------------------------------
#
# `API_SMTP_HOST` is the sentinel: unset → dev `EchoSink` (in-memory
# inbox); set → `SmtpEmailPort` (lettre). Set + invalid → boot fails
# CLOSED (no silent fallback to EchoSink). See apps/server/README.md
# §"Email delivery (SMTP)" for the full env-binding contract.
#
# API_SMTP_HOST=smtp.example.com
# API_SMTP_PORT=587                       # default 587 (STARTTLS submission)
# API_SMTP_USERNAME=noreply@example.com   # if set, PASSWORD is required
# API_SMTP_PASSWORD=replace-me            # SecretString — NEVER commit
# API_SMTP_FROM=noreply@example.com       # required; must contain '@'
# API_SMTP_TLS_MODE=starttls              # none | starttls | implicit
#                                          (port-derived if unset:
#                                          465 → implicit, 587 → starttls,
#                                          other → none + startup warn)

# ----------------------------------------------------------------------------
# API secrets — DO NOT commit. Generate locally; never share.
# ----------------------------------------------------------------------------

# JWT signing secret (HS256 by default). Generate with:
#   openssl rand -hex 64
# API_JWT_SECRET=replace-me

# Optional issuer / audience a bearer JWT must carry. Unset leaves the claim
# unchecked. A JWT's `sub` must be a Nebula user id (`user_<ULID>`).
# API_JWT_ISSUER=
# API_JWT_AUDIENCE=

# Comma-separated operator API keys (`nbl_sk_` prefix) for X-API-Key auth.
# Every key authenticates the same system principal, not a user or tenant;
# tenant routes admit it only where that principal is a member.
# API_KEYS=replace-me,another-key

# ============================================================================
# Logging (crates/log)
# ============================================================================

# tracing-style filter (e.g. `info,nebula_engine=debug`).
# RUST_LOG=info

# Nebula-specific log overrides (see crates/log/src/config/env.rs).
# NEBULA_LOG=info
# NEBULA_LOG_FORMAT=pretty       # pretty | json | compact
# NEBULA_LOG_COLORS=auto         # auto | always | never
# NEBULA_LOG_SOURCE=true         # include file:line
# NEBULA_LOG_TIME=true           # include timestamps

# ============================================================================
# Telemetry — OpenTelemetry / Sentry (crates/log)
# ============================================================================

# OTEL collector endpoint (Jaeger / Tempo / collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry — optional. Leave SENTRY_DSN empty to disable.
# SENTRY_DSN=
# SENTRY_ENV=dev
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
