## trait nebula_resource::topology::contract::Topology
exported as nebula_sdk::integration::resource::Topology
pub trait Topology<R: Provider>: Send + Sync + 'static {
    type Entry: Send + Sync + 'static;
    fn try_reserve(&self, store: StoreView<'_, Self::Entry>) -> Result<Ticket, Unavailable>;
    fn create_entry(&self, resource: &R, config: &R::Config, ctx: &ResourceContext, retained: &RetainedStore<Self::Entry>) -> impl Future<Output = Result<CreatedEntry<Self::Entry>, Error>> + Send;
    fn entry_instance<'s>(&self, entry: &'s Self::Entry) -> &'s R::Instance;
    fn into_owned_instance(&self, entry: Self::Entry) -> Option<R::Instance>;
    fn quiesce(&self) -> impl Future<Output = Result<(), Error>> + Send { .. }
    fn accept(&self, _entry: &mut Self::Entry, _resource: &R, _ctx: &ResourceContext) -> impl Future<Output = bool> + Send { .. }
    fn prepare(&self, _entry: &mut Self::Entry, _resource: &R, _ctx: &ResourceContext) -> impl Future<Output = Result<(), Error>> + Send { .. }
    fn on_release(&self, _entry: &mut Self::Entry, _resource: &R) -> impl Future<Output = Result<bool, Error>> + Send { .. }
    fn pools(&self) -> bool { .. }
    fn handles_own_revoke(&self) -> bool { .. }
    fn store_capacity(&self) -> Option<usize> { .. }
    fn queue_strategy(&self) -> PoolStrategy { .. }
    fn warmup_target(&self, _config: &R::Config) -> usize { .. }
    fn warmup_strategy(&self) -> crate::topology::pooled::config::WarmupStrategy { .. }
    fn idle_evictable(&self, _entry: &Self::Entry) -> bool { .. }
    fn maintenance_schedule(&self) -> Option<MaintenanceSchedule> { .. }
    fn dispatch_credential_hook(&self, _resource: &R, _store: StoreView<'_, Self::Entry>, _retained: &RetainedStore<Self::Entry>, _slot: &str, _refresh: bool) -> impl Future<Output = Result<(), HookFault>> + Send { .. }
    fn set_fingerprint(&self, _fingerprint: u64) { .. }
    fn inherit_from(&self, _previous: &Self) { .. }
    fn leases_out(&self) -> Option<usize> { .. }
    fn live_instances(&self) -> Option<usize> { .. }
    fn phase(&self, _store: StoreView<'_, Self::Entry>) -> AdmissionPhase { .. }
    fn load(&self, _store: StoreView<'_, Self::Entry>) -> Option<Load> { .. }
    fn tag(&self) -> TopologyTag { .. }
}

